      "KeysToMetaData": {
        "ID_INVENTORY_STASH_OVERFLOWING_EXPAND": {
          "Note": "\"Short warning next to the player' stash on the inventory screen, letting them know that their stash has entered the soft limit (too many things in their stash), blocking them from making certain actions, and encouraging them to manage their loot to make space. They can spend credits to expand the size of their stash (which moves the soft limit further)\"",
          "Status": "approved"
        },
        "ID_INVENTORY_STASH_FULL_EXPAND": {
          "Note": "\"Short warning next to the player' stash on the inventory screen, letting them know that their stash has entered the soft limit (too many things in their stash), blocking them from making certain actions, and encouraging them to manage their loot to make space. They can spend credits to expand the size of their stash (which moves the soft limit further) - Alternative\"",
          "Status": "approved"
        },
        "ID_INVENTORY_STASH_OVERFLOWING_MAKESPACE": {
          "Note": "\"Short warning next to the player' stash letting the player know that they have now entered the HARD limit and they really need to make space in their stash. Not doing so will prevent them from doing basic actions in the game (deploy, craft, etc). This is due to tech limitations on our side.\"",
